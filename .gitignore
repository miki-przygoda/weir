# will have compiled files and executables
debug/
target/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# RustRover
.idea/

# mdBook build output (CI builds and publishes; never committed)
book/

# Other
.DS_Store
PLAN.md
todos

# Local working docs (plans, scratch notes — not part of the repo)
.workdocs/
# Subagent-driven-development scratch (ledgers, briefs, review packages).
.superpowers/

# Schedules generated per-launch by chaos/run-docker-soak.sh — the base
# schedule is the source of truth; these are derived and disposable.
chaos/schedules/generated/
