# Generated by Cargo
# will have compiled files and executables
debug/
target/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# RustRover
.idea/

# mdBook build output (CI builds and publishes; never committed)
book/

# Other
.DS_Store
PLAN.md
todos
__pycache__/

# Local working docs (plans, scratch notes — not part of the repo)
.workdocs/
# Subagent-driven-development scratch (ledgers, briefs, review packages).
.superpowers/

# Schedules generated per-launch by chaos/run-docker-soak.sh — the base
# schedule is the source of truth; these are derived and disposable.
chaos/schedules/generated/

# Local CI runner: the technique is documented in deploy/ci-local/README.md,
# but the implementation is deliberately NOT tracked — see that file for why.
# Everything in the directory is ignored except the README.
deploy/ci-local/*
!deploy/ci-local/README.md
scripts/ci-local
target-docker/
# The load job appends BENCH lines here; harmless in CI's fresh checkout,
# but it accumulates in a working tree when the suite is run locally.
load_results.jsonl
